<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Restablecer Contraseña</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<style>
.modern-input {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
    border: 4px solid rgba(234, 179, 8, 0.5);
}

</style>
<body class="min-h-screen flex items-center justify-center">
  <img src="img/FondoRegistro.png" class="absolute inset-0 w-full h-full object-cover md:object-fill -z-10">

  <div class="bg-white rounded-lg shadow-xl w-full max-w-md overflow-hidden modern-input border">
    <div class="bg-purple-600 py-4 px-6">
      <h1 class="text-xl font-bold text-white text-center">Restablecer Contraseña</h1>
    </div>
    
    <div class="p-6">
      <!-- CAMBIO: Quitar el form tradicional y usar div -->
      <div id="resetForm" class="space-y-4">
        <input type="hidden" id="token" value="<%= token %>">
        
        <div>
          <label for="password" class="block text-sm font-medium text-gray-700 mb-1">
            Nueva Contraseña
          </label>
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="8"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500 transition"
            placeholder="Mínimo 8 caracteres"
          >
        </div>

        <div>
          <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-1">
            Confirmar Contraseña
          </label>
          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            required
            minlength="8"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-yellow-500 transition"
            placeholder="Repite tu contraseña"
          >
        </div>

        <button
          type="button"
          id="submitBtn"
          class="w-full bg-yellow-600 hover:bg-yellow-700 text-white font-medium py-2 px-4 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition"
        >
          Cambiar Contraseña
        </button>
      </div>
      
      <div class="mt-4 text-center">
        <a href="/login" class="text-black hover:text-purple-500 text-sm">Volver al inicio de sesión</a>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('submitBtn').addEventListener('click', async function() {
      const token = document.getElementById('token').value;
      const password = document.getElementById('password').value;
      const confirmPassword = document.getElementById('confirmPassword').value;
      
      // Validaciones
      if (password !== confirmPassword) {
        Swal.fire({
          icon: 'error',
          title: 'Las contraseñas no coinciden',
          text: 'Por favor verifica que ambas contraseñas sean iguales',
          confirmButtonColor: '#3B82F6',
        });
        return;
      }
      
      if (password.length < 8) {
        Swal.fire({
          icon: 'error',
          title: 'Contraseña muy corta',
          text: 'La contraseña debe tener al menos 8 caracteres',
          confirmButtonColor: '#3B82F6',
        });
        return;
      }

      // Validación de fortaleza
      const tieneMayuscula = /[A-Z]/.test(password);
      const tieneNumero = /[0-9]/.test(password);
      const tieneEspecial = /[!@#$%^&*(),.?":{}|<>]/.test(password);
      
      if (!tieneMayuscula || !tieneNumero || !tieneEspecial) {
        Swal.fire({
          icon: 'error',
          title: 'Contraseña débil',
          text: 'Debe incluir mayúsculas, números y caracteres especiales',
          confirmButtonColor: '#3B82F6',
        });
        return;
      }

      // Enviar por fetch al backend API
      try {
        const response = await fetch('/api/password/reset-password', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            token: token,
            password: password
          })
        });

        const data = await response.json();

        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: '¡Éxito!',
            text: data.message,
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            willClose: () => {
              window.location.href = '/login';
            }
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: data.error,
            confirmButtonColor: '#3B82F6',
          });
        }
      } catch (error) {
        Swal.fire({
          icon: 'error',
          title: 'Error de conexión',
          text: 'No se pudo conectar con el servidor',
          confirmButtonColor: '#3B82F6',
        });
      }
    });
  </script>
</body>
</html>