<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registro - Presupuesto Personal</title>
  <meta name="description" content="Únete a nuestra plataforma de presupuestos personales y comienza tu viaje hacia la libertad financiera">
  <link rel="icon" href="img/Logo.ico" type="image/x-icon">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- ✅ AGREGAR SWEETALERT2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    .bg-gradient-radial {
      background-image: radial-gradient(circle, var(--tw-gradient-stops));
    }
    html, body {
      overflow-y: auto;
      height: 100%;
    }
    .text-gradient {
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
      padding-bottom: 0.2em;
    }
    .toggle-image-btn {
      transition: all 0.3s ease;
    }
    .toggle-image-btn:hover {
      transform: rotate(90deg);
    }
    
    /* Mejoras de accesibilidad */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    
    /* Mejorar contraste para modo alto contraste */
    @media (prefers-contrast: high) {
      .text-slate-300 { color: #000; }
      .text-slate-600 { color: #000; }
      .border-slate-300 { border-color: #000; }
    }
    
    /* Reducir movimiento para usuarios que lo prefieren */
    @media (prefers-reduced-motion: reduce) {
      .animate-pulse { animation: none; }
      .transition-all { transition: none; }
      .hover\:scale-105:hover { transform: none; }
      .toggle-image-btn:hover { transform: none; }
    }
    
    /* Mejoras de focus para navegación por teclado */
    .focus\:ring-2:focus {
      outline: 2px solid transparent;
      outline-offset: 2px;
    }

    /* Estilos personalizados para SweetAlert2 */
    .swal2-popup {
      border-radius: 12px !important;
      font-family: system-ui, -apple-system, sans-serif;
    }
    .swal2-success {
      border-color: #10b981 !important;
    }
    .swal2-error {
      border-color: #ef4444 !important;
    }
  </style>
</head>
<body class="min-h-screen relative overflow-y-auto bg-slate-900">
  <!-- Fondo financiero elegante -->
  <div class="fixed inset-0 bg-gradient-to-br from-slate-900 via-blue-900 to-slate-800 -z-10" aria-hidden="true">
    <!-- Monedas y símbolos financieros flotantes -->
    <div class="absolute inset-0 opacity-40" aria-hidden="true">
      <!-- Símbolos de dinero (reducidos para mejor rendimiento) -->
      <div class="absolute top-10 left-10 text-2xl text-emerald-400 animate-pulse font-bold" aria-hidden="true">$</div>
      <div class="absolute top-20 right-20 text-xl text-blue-300 animate-pulse delay-1000 font-bold" aria-hidden="true">€</div>
      <div class="absolute top-40 left-1/4 text-lg text-slate-300 animate-pulse delay-500 font-bold" aria-hidden="true">¥</div>
      <div class="absolute bottom-40 left-20 text-xl text-emerald-300 animate-pulse delay-300 font-bold" aria-hidden="true">$</div>
      <div class="absolute bottom-60 right-40 text-lg text-purple-300 animate-pulse delay-1200 font-bold" aria-hidden="true">₿</div>
    </div>

    <!-- Efectos sutiles -->
    <div class="absolute top-0 left-0 w-full h-full bg-gradient-radial from-blue-500/10 via-transparent to-transparent" aria-hidden="true"></div>
    <div class="absolute bottom-0 right-0 w-full h-full bg-gradient-radial from-emerald-500/10 via-transparent to-transparent" aria-hidden="true"></div>
  </div>

  <!-- Contenido principal -->
  <div class="relative z-10 py-8 px-4 min-h-screen">
    <div class="max-w-6xl mx-auto">
      <!-- Header - Texto "Registro" mejorado -->
      <header class="text-center space-y-4 mb-8 pt-6">
        <h1 class="text-4xl md:text-6xl font-bold bg-gradient-to-r from-white via-blue-200 to-emerald-200 text-gradient pb-3 drop-shadow-2xl">
          💰 Registro
        </h1>
        <p class="text-lg md:text-xl text-white font-medium">Únete a la plataforma de presupuestos más inteligente</p>
        <p class="text-sm text-slate-300">
          Comienza tu viaje hacia la libertad financiera. Esta información se mostrará públicamente.
        </p>
      </header>

      <!-- Formulario principal -->
      <main>
        <div class="border-slate-600/50 bg-white/95 backdrop-blur-xl shadow-2xl rounded-xl mb-10">
          <div class="p-6 md:p-8">
            <form action="/registrar" method="POST" enctype="multipart/form-data" class="space-y-8" autocomplete="off" id="registroForm">
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8">
                <!-- Columna izquierda - Información personal -->
                <div class="space-y-6">
                  <div class="space-y-4">
                    <h2 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                      👤 Información Personal
                    </h2>
                    <div class="bg-slate-200 h-px w-full" aria-hidden="true"></div>
                  </div>

                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-2">
                      <label for="nom" class="text-slate-700 font-medium flex items-center gap-2">
                        <i data-lucide="user" class="h-4 w-4 text-blue-500" aria-hidden="true"></i>
                        Nombres
                        <span class="text-red-500" aria-hidden="true">*</span>
                      </label>
                      <input
                        type="text"
                        id="nom"
                        name="nom"
                        placeholder="Juan Carlos"
                        required
                        aria-required="true"
                        class="w-full px-3 py-2 border border-slate-300 rounded-md bg-white text-slate-900 placeholder:text-slate-500 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all duration-200"
                      />
                    </div>
                    <div class="space-y-2">
                      <label for="apell" class="text-slate-700 font-medium flex items-center gap-2">
                        <i data-lucide="user" class="h-4 w-4 text-blue-500" aria-hidden="true"></i>
                        Apellidos
                        <span class="text-red-500" aria-hidden="true">*</span>
                      </label>
                      <input
                        type="text"
                        id="apell"
                        name="apell"
                        placeholder="Pérez Gómez"
                        required
                        aria-required="true"
                        class="w-full px-3 py-2 border border-slate-300 rounded-md bg-white text-slate-900 placeholder:text-slate-500 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 transition-all duration-200"
                      />
                    </div>
                  </div>

                  <div class="space-y-2">
                    <label for="username" class="text-slate-700 font-medium flex items-center gap-2">
                      <i data-lucide="user" class="h-4 w-4 text-indigo-500" aria-hidden="true"></i>
                      Nombre de usuario
                      <span class="text-red-500" aria-hidden="true">*</span>
                    </label>
                    <input
                      type="text"
                      id="username"
                      name="username"
                      placeholder="janesmith123"
                      required
                      aria-required="true"
                      autocomplete="username"
                      class="w-full px-3 py-2 border border-slate-300 rounded-md bg-white text-slate-900 placeholder:text-slate-500 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 transition-all duration-200"
                    />
                  </div>
                  
                  <div class="space-y-4">
                    <div class="space-y-2">
                      <label for="prof" class="text-slate-700 font-medium flex items-center gap-2">
                         💼 Profesión
                      </label>
                      <input
                        type="text"
                        id="prof"
                        name="prof"
                        placeholder="Ej. Analista Financiero"
                        aria-describedby="prof-help"
                        class="w-full px-3 py-2 border border-slate-300 rounded-md bg-white text-slate-900 placeholder:text-slate-500 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/20 transition-all duration-200"
                      />
                      <div id="prof-help" class="sr-only">Opcional - Tu profesión o ocupación actual</div>
                    </div>
                  </div>
                  
                  <div class="space-y-2">
                    <label for="email" class="text-slate-700 font-medium flex items-center gap-2">
                      <i data-lucide="mail" class="h-4 w-4 text-purple-500" aria-hidden="true"></i>
                      Correo electrónico
                      <span class="text-red-500" aria-hidden="true">*</span>
                    </label>
                    <input
                      type="email"
                      id="email"
                      name="email"
                      placeholder="ejemplo@tucorreo.com"
                      required
                      aria-required="true"
                      autocomplete="email"
                      class="w-full px-3 py-2 border border-slate-300 rounded-md bg-white text-slate-900 placeholder:text-slate-500 focus:border-purple-500 focus:ring-2 focus:ring-purple-500/20 transition-all duration-200"
                    />
                  </div>

                  <div class="space-y-2">
                    <label for="pass" class="text-slate-700 font-medium flex items-center gap-2">
                      <i data-lucide="lock" class="h-4 w-4 text-red-500" aria-hidden="true"></i>
                      Contraseña
                      <span class="text-red-500" aria-hidden="true">*</span>
                    </label>
                    <input
                      type="password"
                      id="pass"
                      name="pass"
                      placeholder="********"
                      minlength="6"
                      required
                      aria-required="true"
                      autocomplete="new-password"
                      aria-describedby="password-requirements"
                      class="w-full px-3 py-2 border border-slate-300 rounded-md bg-white text-slate-900 placeholder:text-slate-500 focus:border-red-500 focus:ring-2 focus:ring-red-500/20 transition-all duration-200"
                    />
                    <p id="password-requirements" class="text-xs text-slate-600">
                      🔒 La contraseña debe tener al menos 6 caracteres para proteger tus finanzas.
                    </p>
                  </div>
                </div>

                <!-- Columna derecha - Foto y detalles adicionales -->
                <div class="space-y-6">
                  <!-- Foto de perfil -->
                  <div class="space-y-4">
                    <h2 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                      <i data-lucide="camera" class="h-6 w-6 text-emerald-600" aria-hidden="true"></i> Foto de Perfil
                    </h2>
                    <div class="bg-slate-200 h-px w-full" aria-hidden="true"></div>
                  </div>

                  <div class="flex flex-col items-center space-y-4">
                    <!-- Preview principal - circular -->
                    <div class="relative">
                      <div class="w-32 h-32 md:w-40 md:h-40 border-4 border-slate-200 rounded-full bg-slate-50 shadow-lg flex items-center justify-center overflow-hidden" role="img" aria-label="Vista previa de foto de perfil">
                        <img
                          id="preview"
                          src=""
                          alt="Vista previa de la foto de perfil seleccionada"
                          class="w-full h-full object-cover hidden"
                          style="object-position: center;"
                        />
                        <div id="default-icon" class="flex flex-col items-center" aria-hidden="true">
                          <i data-lucide="user" class="h-8 w-8 md:h-12 md:w-12 text-slate-400 mb-2"></i>
                          <i data-lucide="dollar-sign" class="h-6 w-6 md:h-8 md:w-8 text-emerald-500"></i>
                        </div>
                      </div>
                      <button
                        type="button"
                        onclick="removeImage()"
                        id="btnEliminar"
                        class="absolute -top-2 -right-2 h-6 w-6 md:h-8 md:w-8 rounded-full p-0 bg-red-500 hover:bg-red-400 shadow-lg hidden items-center justify-center text-white focus:ring-2 focus:ring-red-500 focus:ring-offset-2"
                        aria-label="Eliminar imagen"
                      >
                        <i data-lucide="x" class="h-3 w-3 md:h-4 md:w-4"></i>
                      </button>
                      <button
                        type="button"
                        onclick="toggleImageStyle()"
                        id="btnToggleStyle"
                        class="absolute -bottom-2 -right-2 h-6 w-6 md:h-8 md:w-8 rounded-full p-0 bg-blue-500 hover:bg-blue-400 shadow-lg hidden items-center justify-center text-white toggle-image-btn focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
                        aria-label="Alternar entre ajustar imagen o cubrir contenedor"
                        title="Ajustar imagen"
                      >
                        <i data-lucide="rotate-ccw" class="h-3 w-3 md:h-4 md:w-4"></i>
                      </button>
                    </div>

                    <!-- Preview completo - rectangular -->
                    <div id="fullPreviewContainer" class="w-full max-w-xs hidden">
                      <p class="text-xs text-slate-600 mb-2 text-center">Vista previa completa:</p>
                      <div class="relative bg-slate-50 border-2 border-slate-200 rounded-lg p-2">
                        <img
                          id="fullPreview"
                          src=""
                          alt="Vista previa completa de la imagen seleccionada"
                          class="w-full h-auto max-h-32 object-contain rounded"
                        />
                      </div>
                    </div>

                    <div class="flex flex-col gap-2 w-full max-w-xs">
                      <input
                        type="file"
                        id="foto"
                        name="foto"
                        accept="image/*"
                        class="hidden"
                        onchange="previewImage(event)"
                        aria-describedby="file-help"
                      />
                      <button
                        type="button"
                        onclick="document.getElementById('foto').click()"
                        class="bg-emerald-600 hover:bg-emerald-700 shadow-lg text-white font-medium py-2 px-4 rounded-md flex items-center justify-center focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 transition-all duration-200"
                      >
                        <i data-lucide="camera" class="h-4 w-4 mr-2" aria-hidden="true"></i>💳 Subir imagen
                      </button>
                      <p id="file-help" class="text-xs text-slate-600 text-center">Formatos aceptados: JPG, PNG, GIF, WEBP</p>
                      <p id="imageTip" class="text-xs text-blue-600 text-center hidden">
                        💡 Usa el botón azul para ajustar cómo se ve la imagen
                      </p>
                    </div>
                  </div>

                  <!-- Campos adicionales -->
                  <div class="space-y-2">
                    <label for="expec" class="text-slate-700 font-medium flex items-center gap-2">
                       🎯 Metas Financieras
                    </label>
                    <textarea
                      id="expec"
                      name="expec"
                      rows="4"
                      placeholder="Cuéntanos tus objetivos financieros (ahorro, inversión, reducción de deudas, etc.)..."
                      aria-describedby="expec-help"
                      class="w-full px-3 py-2 border border-slate-300 rounded-md bg-white text-slate-900 placeholder:text-slate-500 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 resize-none transition-all duration-200"
                    ></textarea>
                    <div id="expec-help" class="sr-only">Campo opcional para describir tus metas y objetivos financieros</div>
                  </div>
                </div>
              </div>

              <!-- Sección de notificaciones -->
              <fieldset class="space-y-6">
                <legend class="space-y-4">
                  <h2 class="text-2xl font-bold text-slate-800 flex items-center gap-2">
                     🔔 Notificaciones de Presupuesto
                  </h2>
                  <div class="bg-slate-200 h-px w-full" aria-hidden="true"></div>
                  <p class="text-slate-600">Elige cómo quieres recibir alertas sobre tus finanzas:</p>
                </legend>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                  <!-- Básico -->
                  <label class="group cursor-pointer">
                    <input
                      type="radio"
                      name="notificaciones"
                      value="basico"
                      class="sr-only"
                      required
                      aria-describedby="basico-desc"
                    />
                    <div class="border-2 transition-all duration-300 hover:scale-105 border-slate-200 bg-white hover:bg-slate-50 rounded-xl p-6 text-center group-has-[input:checked]:border-emerald-500 group-has-[input:checked]:bg-emerald-50 group-has-[input:checked]:shadow-lg focus-within:ring-2 focus-within:ring-emerald-500">
                      <div class="flex items-center justify-center gap-2 mb-2">
                        <div class="w-3 h-3 rounded-full bg-emerald-500" aria-hidden="true"></div>
                        <h3 class="text-lg font-bold text-slate-800">💚 Básico</h3>
                      </div>
                      <p id="basico-desc" class="text-sm text-slate-600">📅 Resumen mensual de gastos e ingresos<br>_</p>
                    </div>
                  </label>

                  <!-- Medio -->
                  <label class="group cursor-pointer">
                    <input
                      type="radio"
                      name="notificaciones"
                      value="medio"
                      class="sr-only"
                      aria-describedby="medio-desc"
                    />
                    <div class="border-2 transition-all duration-300 hover:scale-105 border-slate-200 bg-white hover:bg-slate-50 rounded-xl p-6 text-center group-has-[input:checked]:border-amber-500 group-has-[input:checked]:bg-amber-50 group-has-[input:checked]:shadow-lg focus-within:ring-2 focus-within:ring-amber-500">
                      <div class="flex items-center justify-center gap-2 mb-2">
                        <div class="w-3 h-3 rounded-full bg-amber-500" aria-hidden="true"></div>
                        <h3 class="text-lg font-bold text-slate-800">💛 Moderado</h3>
                      </div>
                      <p id="medio-desc" class="text-sm text-slate-600">📊 Resumen mensual + alertas de límites de gastos</p>
                    </div>
                  </label>

                  <!-- Intenso -->
                  <label class="group cursor-pointer">
                    <input
                      type="radio"
                      name="notificaciones"
                      value="intenso"
                      class="sr-only"
                      aria-describedby="intenso-desc"
                    />
                    <div class="border-2 transition-all duration-300 hover:scale-105 border-slate-200 bg-white hover:bg-slate-50 rounded-xl p-6 text-center group-has-[input:checked]:border-orange-500 group-has-[input:checked]:bg-orange-50 group-has-[input:checked]:shadow-lg focus-within:ring-2 focus-within:ring-orange-500">
                      <div class="flex items-center justify-center gap-2 mb-2">
                        <div class="w-3 h-3 rounded-full bg-orange-500" aria-hidden="true"></div>
                        <h3 class="text-lg font-bold text-slate-800">🧡 Completo</h3>
                      </div>
                      <p id="intenso-desc" class="text-sm text-slate-600">
                        📈 Alertas diarias, semanales y recordatorios de pagos
                      </p>
                    </div>
                  </label>
                </div>
              </fieldset>

              <!-- Botones de acción -->
              <div class="flex flex-col sm:flex-row gap-4 justify-end pt-6">
                <a
                  href="/login"
                  class="sm:w-auto w-full border border-slate-300 text-slate-700 hover:bg-red-50 hover:border-red-300 hover:text-red-700 transition-all duration-300 bg-transparent font-medium py-2 px-4 rounded-md flex items-center justify-center focus:ring-2 focus:ring-red-500 focus:ring-offset-2"
                >
                  ❌ Cancelar
                </a>
                <button
                  type="submit"
                  class="sm:w-auto w-full bg-gradient-to-r from-blue-600 to-emerald-600 hover:from-blue-700 hover:to-emerald-700 text-white font-bold shadow-lg transition-all duration-300 py-2 px-4 rounded-md flex items-center justify-center focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
                >
                  <i data-lucide="user-plus" class="h-5 w-5 mr-2" aria-hidden="true"></i>💰 Comenzar mi Presupuesto
                </button>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- ✅ SCRIPT MEJORADO CON ALERTAS BONITAS -->
  <script>
    // Inicializar iconos Lucide
    lucide.createIcons();

    let currentImageStyle = 'cover';

    // ✅ FUNCIÓN MEJORADA PARA MOSTRAR ALERTAS BONITAS
    function showAlert(title, message, icon, callback = null) {
      // Verificar si SweetAlert2 está disponible
      if (typeof Swal === 'undefined') {
        alert(`${title}: ${message}`);
        if (callback) callback();
        return;
      }

      const Toast = Swal.mixin({
        toast: true,
        position: 'top-end',
        showConfirmButton: false,
        timer: 4000,
        timerProgressBar: true,
        didOpen: (toast) => {
          toast.onmouseenter = Swal.stopTimer;
          toast.onmouseleave = Swal.resumeTimer;
        }
      });

      // Alertas especiales para éxito/error
      if (icon === 'success' && title.includes('éxito')) {
        Swal.fire({
          title: '🎉 ' + title,
          text: message,
          icon: 'success',
          confirmButtonText: '¡Genial!',
          confirmButtonColor: '#10b981',
          background: '#f0fdf4',
          iconColor: '#10b981',
          timer: 5000,
          timerProgressBar: true,
          willClose: callback
        });
      } else if (icon === 'error') {
        Swal.fire({
          title: '❌ ' + title,
          text: message,
          icon: 'error',
          confirmButtonText: 'Entendido',
          confirmButtonColor: '#ef4444',
          background: '#fef2f2',
          iconColor: '#ef4444'
        });
      } else {
        Toast.fire({
          icon: icon,
          title: message
        });
      }
    }

    // ✅ INTERCEPTAR EL ENVÍO DEL FORMULARIO CON ALERTAS MEJORADAS
    document.getElementById('registroForm')?.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const submitBtn = this.querySelector('button[type="submit"]');
      const originalText = submitBtn.innerHTML;
      
      // Validación básica antes de enviar
      const requiredFields = ['username', 'nom', 'apell', 'pass', 'email'];
      const missingFields = requiredFields.filter(field => {
        const element = document.getElementById(field);
        return !element.value.trim();
      });

      if (missingFields.length > 0) {
        showAlert('Campos requeridos', 'Por favor completa todos los campos obligatorios', 'warning');
        document.getElementById(missingFields[0]).focus();
        return;
      }

      // Validación de contraseña
      const password = document.getElementById('pass').value;
      if (password.length < 6) {
        showAlert('Contraseña muy corta', 'La contraseña debe tener al menos 6 caracteres', 'warning');
        document.getElementById('pass').focus();
        return;
      }

      // Validación de email
      const email = document.getElementById('email').value;
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        showAlert('Email inválido', 'Por favor ingresa un email válido', 'warning');
        document.getElementById('email').focus();
        return;
      }

      // Deshabilitar botón durante el envío
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<i data-lucide="loader" class="h-5 w-5 mr-2 animate-spin"></i>Creando cuenta...';
      lucide.createIcons();

      // Obtener datos del formulario
      const formData = new FormData();
      
      // Agregar campos de texto
      formData.append('username', document.getElementById('username').value);
      formData.append('nom', document.getElementById('nom').value);
      formData.append('apell', document.getElementById('apell').value);
      formData.append('pass', document.getElementById('pass').value);
      formData.append('email', document.getElementById('email').value);
      formData.append('prof', document.getElementById('prof').value);
      formData.append('expec', document.getElementById('expec').value);
      
      // Agregar notificaciones
      const notificacionSelected = document.querySelector('input[name="notificaciones"]:checked');
      if (notificacionSelected) {
        formData.append('notificaciones', notificacionSelected.value);
      }
      
      // Agregar archivo si existe
      const fotoInput = document.getElementById('foto');
      if (fotoInput.files[0]) {
        formData.append('foto', fotoInput.files[0]);
      }

      try {
        // Mostrar loading bonito
        Swal.fire({
          title: 'Creando tu cuenta...',
          text: 'Estamos procesando tu información financiera',
          allowOutsideClick: false,
          didOpen: () => {
            Swal.showLoading();
          }
        });

        const response = await fetch('https://automatic-journey-5g5wgjj75gjq2p6pg-3000.app.github.dev/api/auth/registrar', {
          method: 'POST',
          body: formData,
          credentials: 'include'
        });

        const result = await response.json();

        // Cerrar loading
        Swal.close();

        if (!response.ok) {
          throw new Error(result.error || 'Error en el registro');
        }

        // ✅ REGISTRO EXITOSO CON ALERTA BONITA
        if (result.success) {
          showAlert(
            '¡Registro Exitoso!', 
            '🎊 Tu cuenta ha sido creada correctamente. ¡Bienvenido a la libertad financiera! Redirigiendo...', 
            'success',
            () => {
              window.location.href = '/';
            }
          );
          
          // Redirigir automáticamente después de 3 segundos
          setTimeout(() => {
            window.location.href = '/';
          }, 3000);
        }

      } catch (error) {
        console.error('Error en registro:', error);
        
        // Manejar diferentes tipos de errores con alertas específicas
        let errorTitle = 'Error en el registro';
        let errorMessage = error.message || 'Ha ocurrido un error inesperado';
        
        // Mensajes específicos para errores comunes
        if (error.message.includes('ya existe')) {
          errorTitle = 'Usuario o email existente';
          errorMessage = 'El nombre de usuario o email ya están registrados. ¿Ya tienes una cuenta?';
        } else if (error.message.includes('contraseña')) {
          errorTitle = 'Contraseña inválida';
          errorMessage = 'La contraseña no cumple con los requisitos de seguridad';
        } else if (error.message.includes('email')) {
          errorTitle = 'Email inválido';
          errorMessage = 'Por favor verifica que el email sea válido';
        } else if (error.message.includes('red') || error.message.includes('fetch')) {
          errorTitle = 'Error de conexión';
          errorMessage = 'No se pudo conectar con el servidor. Verifica tu conexión a internet.';
        }
        
        showAlert(errorTitle, errorMessage, 'error');
        
        // Rehabilitar botón
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
        lucide.createIcons();
      }
    });

    // ✅ FUNCIONES DE MANEJO DE IMÁGENES (igual que antes)
    function previewImage(event) {
      const input = event.target;
      const preview = document.getElementById('preview');
      const fullPreview = document.getElementById('fullPreview');
      const defaultIcon = document.getElementById('default-icon');
      const btnEliminar = document.getElementById('btnEliminar');
      const btnToggleStyle = document.getElementById('btnToggleStyle');
      const fullPreviewContainer = document.getElementById('fullPreviewContainer');
      const imageTip = document.getElementById('imageTip');

      if (input.files && input.files[0]) {
        // Validar tamaño de archivo (max 5MB)
        if (input.files[0].size > 5 * 1024 * 1024) {
          showAlert('Archivo muy grande', 'La imagen debe ser menor a 5MB', 'warning');
          input.value = '';
          return;
        }

        const reader = new FileReader();
        reader.onload = function(e) {
          preview.src = e.target.result;
          fullPreview.src = e.target.result;
          preview.classList.remove('hidden');
          defaultIcon.classList.add('hidden');
          btnEliminar.classList.remove('hidden');
          btnToggleStyle.classList.remove('hidden');
          fullPreviewContainer.classList.remove('hidden');
          imageTip.classList.remove('hidden');
          
          // Aplicar estilo inicial
          preview.style.objectFit = currentImageStyle;
          preview.style.objectPosition = 'center';
        };
        reader.readAsDataURL(input.files[0]);
      }
    }

    function toggleImageStyle() {
      const preview = document.getElementById('preview');
      currentImageStyle = currentImageStyle === 'cover' ? 'contain' : 'cover';
      preview.style.objectFit = currentImageStyle;
      
      // Mostrar mensaje informativo
      const message = currentImageStyle === 'cover' ? 
        'Imagen ajustada para cubrir el círculo' : 
        'Imagen ajustada para mostrarse completa';
      
      showAlert('Ajuste de imagen', message, 'info');
      
      // Animación del botón
      const btn = document.getElementById('btnToggleStyle');
      btn.style.transform = 'rotate(90deg)';
      setTimeout(() => {
        btn.style.transform = 'rotate(0deg)';
      }, 300);
    }

    function removeImage() {
      const input = document.getElementById('foto');
      const preview = document.getElementById('preview');
      const fullPreview = document.getElementById('fullPreview');
      const defaultIcon = document.getElementById('default-icon');
      const btnEliminar = document.getElementById('btnEliminar');
      const btnToggleStyle = document.getElementById('btnToggleStyle');
      const fullPreviewContainer = document.getElementById('fullPreviewContainer');
      const imageTip = document.getElementById('imageTip');

      input.value = '';
      preview.src = '';
      fullPreview.src = '';
      preview.classList.add('hidden');
      defaultIcon.classList.remove('hidden');
      btnEliminar.classList.add('hidden');
      btnToggleStyle.classList.add('hidden');
      fullPreviewContainer.classList.add('hidden');
      imageTip.classList.add('hidden');
      currentImageStyle = 'cover';
      
      showAlert('Imagen eliminada', 'La foto de perfil ha sido removida', 'info');
    }

    // ✅ VALIDACIÓN EN TIEMPO REAL MEJORADA
    document.getElementById('email')?.addEventListener('blur', function() {
      const email = this.value;
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      
      if (email && !emailRegex.test(email)) {
        this.classList.add('border-red-500');
        showAlert('Email inválido', 'El formato del email no es correcto', 'warning');
      } else {
        this.classList.remove('border-red-500');
      }
    });

    document.getElementById('pass')?.addEventListener('input', function() {
      if (this.value.length > 0 && this.value.length < 6) {
        this.classList.add('border-amber-500');
      } else {
        this.classList.remove('border-amber-500');
      }
    });

    // ✅ MOSTRAR MENSAJES DEL SERVIDOR SI EXISTEN
    document.addEventListener('DOMContentLoaded', function() {
      // Buscar parámetros de URL para mensajes
      const urlParams = new URLSearchParams(window.location.search);
      const success = urlParams.get('success');
      const error = urlParams.get('error');
      
      if (success) {
        showAlert('¡Éxito!', decodeURIComponent(success), 'success');
        // Limpiar URL
        window.history.replaceState({}, document.title, window.location.pathname);
      }
      
      if (error) {
        showAlert('Error', decodeURIComponent(error), 'error');
        // Limpiar URL
        window.history.replaceState({}, document.title, window.location.pathname);
      }
    });

    // ✅ MEJORAR NAVEGACIÓN POR TECLADO
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        document.activeElement.blur();
      }
    });
  </script>
</body>
</html>