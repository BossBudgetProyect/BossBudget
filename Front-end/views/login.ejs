<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <link rel="icon" href="/img/Logo.ico" type="image/x-icon">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Página de inicio de sesión">
  
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet">

  <title>Inicio de Sesión - BossBudget</title>
  <style>
    @layer utilities {
      .font-bebas { font-family: 'Bebas Neue', sans-serif; }
    }

    .modern-input {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      transition: all 0.3s ease;
      border: 2px solid rgba(234, 179, 8, 0.5);
    }

    .modern-input:focus {
      background: rgba(255, 255, 255, 1);
      border-color: rgb(192, 38, 211);
      box-shadow: 0 0 0 4px rgba(243, 240, 240, 0.1);
      transform: translateY(-2px);
    }

    .modern-button {
      background: linear-gradient(135deg, rgb(0, 0, 0) 0%, #000000 100%);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .modern-button::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.5s;
    }

    .modern-button:hover::before {
      left: 100%;
    }

    .modern-button:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 30px rgba(192, 38, 211, 0.4);
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .fade-in {
      animation: fadeInUp 0.8s ease-out forwards;
    }

    .glass-effect {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.3);
      box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
    }
  </style>
</head>
<body class="relative min-h-screen bg-gray-900">
  <img src="/img/fondoiniciosesion.png" class="absolute inset-0 w-full h-full object-cover -z-10" alt="Fondo inicio sesión">
  
  <div class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md fade-in">
      <div class="glass-effect rounded-2xl shadow-2xl p-8 md:p-10">
        <!-- Header -->
        <div class="text-center mb-8">
          <h1 class="text-4xl font-bebas font-bold text-white mb-2">BossBudget</h1>
          <p class="text-gray-300">Controla tus finanzas de forma inteligente</p>
        </div>

        <!-- Login Form -->
        <form id="loginForm" class="space-y-6">
          <!-- Email Input -->
          <div>
            <label for="email" class="block text-sm font-medium text-gray-200 mb-2">
              📧 Correo Electrónico
            </label>
            <input
              id="email"
              type="email"
              name="email"
              placeholder="tu@email.com"
              required
              class="modern-input w-full px-4 py-3 rounded-lg text-gray-800 placeholder:text-gray-500 focus:outline-none"
            />
          </div>

          <!-- Password Input -->
          <div>
            <label for="password" class="block text-sm font-medium text-gray-200 mb-2">
              🔐 Contraseña
            </label>
            <input
              id="password"
              type="password"
              name="pass"
              placeholder="Mínimo 6 caracteres"
              required
              class="modern-input w-full px-4 py-3 rounded-lg text-gray-800 placeholder:text-gray-500 focus:outline-none"
            />
          </div>

          <!-- Remember Me & Forgot Password -->
          <div class="flex items-center justify-between">
            <label class="flex items-center">
              <input type="checkbox" class="w-4 h-4 rounded" />
              <span class="ml-2 text-sm text-gray-300">Recuérdame</span>
            </label>
            <a href="/forgot-password" class="text-sm text-amber-400 hover:text-amber-300">
              ¿Olvidaste contraseña?
            </a>
          </div>

          <!-- Submit Button -->
          <button
            type="submit"
            class="modern-button w-full py-3 px-4 rounded-lg text-white font-semibold text-lg transition-all duration-300"
          >
            ✨ Iniciar Sesión
          </button>
        </form>

        <!-- Divider -->
        <div class="my-6 flex items-center">
          <div class="flex-1 border-t border-gray-400"></div>
          <span class="px-3 text-gray-400">o</span>
          <div class="flex-1 border-t border-gray-400"></div>
        </div>

        <!-- Links -->
        <div class="space-y-3 text-center">
          <p class="text-gray-300">
            ¿No tienes cuenta?
            <a href="/registro" class="text-amber-400 hover:text-amber-300 font-semibold">
              Regístrate aquí
            </a>
          </p>
          <p class="text-gray-400 text-xs">
            Al iniciar sesión, aceptas nuestros
            <a href="#" class="text-amber-400 hover:text-amber-300">Términos de Servicio</a>
          </p>
        </div>
      </div>

      <!-- Info Cards -->
      <div class="mt-8 grid grid-cols-3 gap-4 text-center text-white">
        <div class="glass-effect rounded-lg p-4">
          <p class="text-2xl">💰</p>
          <p class="text-xs mt-2">Gestiona Presupuestos</p>
        </div>
        <div class="glass-effect rounded-lg p-4">
          <p class="text-2xl">📊</p>
          <p class="text-xs mt-2">Analiza Gastos</p>
        </div>
        <div class="glass-effect rounded-lg p-4">
          <p class="text-2xl">🎯</p>
          <p class="text-xs mt-2">Logra Metas</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    const API_BASE_URL = '/api';

    document.getElementById('loginForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const email = document.getElementById('email').value.trim();
      const pass = document.getElementById('password').value.trim();

      if (!email || !pass) {
        Swal.fire({
          icon: 'warning',
          title: 'Campos vacíos',
          text: 'Por favor completa todos los campos',
          background: '#1f2937',
          color: '#fff'
        });
        return;
      }

      try {
        console.log('🔄 Enviando login...');
        const response = await fetch(`${API_BASE_URL}/auth/login`, {
          method: 'POST',
          credentials: 'include',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ email, pass })
        });

        console.log('Response status:', response.status);
        console.log('Response headers:', response.headers);

        if (!response.ok) {
          const errorData = await response.text();
          console.error('❌ Error response:', errorData);
          throw new Error(`HTTP ${response.status}: ${errorData}`);
        }

        const data = await response.json();
        console.log('✅ Login exitoso:', data);

        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: '¡Bienvenido!',
            text: 'Redirigiendo...',
            allowOutsideClick: false,
            background: '#1f2937',
            color: '#fff',
            didOpen: () => {
              setTimeout(() => {
                window.location.href = '/principal';
              }, 1500);
            }
          });
        } else {
          throw new Error(data.message || 'Error en el login');
        }

      } catch (error) {
        console.error('❌ Error en login:', error);
        Swal.fire({
          icon: 'error',
          title: 'Error de Login',
          text: error.message || 'No se pudo completar el login',
          background: '#1f2937',
          color: '#fff'
        });
      }
    });
  </script>
</body>
</html>