<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recuperar Contraseña</title>
  <link rel="icon" href="/img/Logo.ico" type="image/x-icon">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <%- include('partials/config.ejs') %>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">
   <img src="img/fondoiniciosesion.png" class="absolute inset-0 w-full h-full object-cover -z-10" alt="Fondo inicio sesión">  
<style>/* ESTILOS MODERNOS AÑADIDOS */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes float {
    0%, 100% {
        transform: translateY(0px);
    }
    50% {
        transform: translateY(-10px);
    }
}

.glass-effect {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
}

.modern-input {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
    border: 2px solid rgba(234, 179, 8, 0.5);
}

.modern-input:focus {
    background: rgba(255, 255, 255, 1);
    border-color: rgb(192, 38, 211);
    box-shadow: 0 0 0 4px rgba(192, 38, 211, 0.1);
    transform: translateY(-2px);
}

.modern-button {
    background: linear-gradient(135deg, #9236af 0%, #9236af 100%);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.modern-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.5s;
}

.modern-button:hover::before {
    left: 100%;
}

.modern-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(192, 38, 211, 0.4);
}

.fade-in {
    animation: fadeInUp 0.8s ease-out forwards;
}

.logo-float {
    animation: float 3s ease-in-out infinite;
}

/* Animación para las burbujas de la opción 3 */
@keyframes blob {
    0%, 100% {
        transform: translate(0px, 0px) scale(1);
    }
    33% {
        transform: translate(30px, -50px) scale(1.1);
    }
    66% {
        transform: translate(-20px, 20px) scale(0.9);
    }
}

.animate-blob {
    animation: blob 7s infinite;
}

.animation-delay-2000 {
    animation-delay: 2s;
}

.animation-delay-4000 {
    animation-delay: 4s;
}

.modern-link {
    position: relative;
    transition: all 0.3s ease;
}

.modern-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #c026d3, #eab308);
    transition: width 0.3s ease;
}

.modern-link:hover::after {
    width: 100%;
}
</style>
<div class="bg-white p-8 rounded-lg shadow-md w-full max-w-md glass-effect modern-input" style="animation-delay: 0.2s;">
  
    <h1 class="text-2xl font-bold text-center mb-6">Recuperar Contraseña</h1>
    <!-- CAMBIO: Quitar el form tradicional y usar div -->
    <div id="forgotForm" class="space-y-4">
      <div class="mb-4">
        <label for="email" class="block text-gray-700 mb-2 text-black">Correo Electrónico</label>
        <input
          type="email"
          id="email"
          name="email"
          class="w-full px-3 py-2 border rounded-lg outline-none modern-input focus:ring-2 focus:ring-purple-500"
          required
          placeholder="tu@email.com"
        />
      </div>
      <button
        type="button"
        id="submitBtn"
        class="w-full bg-purple-700 text-gray-100 py-2 px-4 rounded-lg hover:bg-purple-800 hover:text-yellow-500 transition"
      >
        Enviar Enlace
      </button>
    </div>

    <div class="mt-4 text-center">
      <a href="/login" class="text-yellow-600 hover:text-purple-800 text-sm">Volver al inicio de sesión</a>
    </div>
  </div>

  <script>
    document.getElementById('submitBtn').addEventListener('click', async function() {
      const email = document.getElementById('email').value;
      const submitBtn = document.getElementById('submitBtn');
      
      // Validación básica de email
      if (!email || !email.includes('@')) {
        Swal.fire({
          icon: 'error',
          title: 'Email inválido',
          text: 'Por favor ingresa un email válido',
          confirmButtonColor: '#3B82F6',
        });
        return;
      }

      // Mostrar loading
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';
      submitBtn.classList.add('opacity-50');

      try {
        const response = await fetch(`${window.APP_CONFIG.API_URL}/api/password/forgot-password`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            email: email
          })
        });

        const data = await response.json();

        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: '¡Éxito!',
            text: data.message,
            confirmButtonColor: '#3B82F6',
            willClose: () => {
              // Opcional: redirigir al login o limpiar el formulario
              document.getElementById('email').value = '';
            }
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: data.error,
            confirmButtonColor: '#3B82F6',
          });
        }
      } catch (error) {
        Swal.fire({
          icon: 'error',
          title: 'Error de conexión',
          text: 'No se pudo conectar con el servidor',
          confirmButtonColor: '#3B82F6',
        });
      } finally {
        // Restaurar botón
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enviar Enlace';
        submitBtn.classList.remove('opacity-50');
      }
    });

    // Permitir enviar con Enter
    document.getElementById('email').addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        document.getElementById('submitBtn').click();
      }
    });
  </script>
</body>
</html>