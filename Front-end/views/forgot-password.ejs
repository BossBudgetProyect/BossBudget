<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Recuperar Contraseña</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">
  <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-md">
    <h1 class="text-2xl font-bold text-center mb-6">Recuperar Contraseña</h1>
    
    <!-- CAMBIO: Quitar el form tradicional y usar div -->
    <div id="forgotForm" class="space-y-4">
      <div class="mb-4">
        <label for="email" class="block text-gray-700 mb-2">Correo Electrónico</label>
        <input
          type="email"
          id="email"
          name="email"
          class="w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
          required
          placeholder="tu@email.com"
        />
      </div>
      <button
        type="button"
        id="submitBtn"
        class="w-full bg-blue-500 text-white py-2 px-4 rounded-lg hover:bg-blue-600 transition"
      >
        Enviar Enlace
      </button>
    </div>

    <div class="mt-4 text-center">
      <a href="/login" class="text-blue-600 hover:text-blue-800 text-sm">Volver al inicio de sesión</a>
    </div>
  </div>

  <script>
    document.getElementById('submitBtn').addEventListener('click', async function() {
      const email = document.getElementById('email').value;
      const submitBtn = document.getElementById('submitBtn');
      
      // Validación básica de email
      if (!email || !email.includes('@')) {
        Swal.fire({
          icon: 'error',
          title: 'Email inválido',
          text: 'Por favor ingresa un email válido',
          confirmButtonColor: '#3B82F6',
        });
        return;
      }

      // Mostrar loading
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando...';
      submitBtn.classList.add('opacity-50');

      try {
        const response = await fetch('https://automatic-journey-5g5wgjj75gjq2p6pg-3000.app.github.dev/api/password/forgot-password', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            email: email
          })
        });

        const data = await response.json();

        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: '¡Éxito!',
            text: data.message,
            confirmButtonColor: '#3B82F6',
            willClose: () => {
              // Opcional: redirigir al login o limpiar el formulario
              document.getElementById('email').value = '';
            }
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: data.error,
            confirmButtonColor: '#3B82F6',
          });
        }
      } catch (error) {
        Swal.fire({
          icon: 'error',
          title: 'Error de conexión',
          text: 'No se pudo conectar con el servidor',
          confirmButtonColor: '#3B82F6',
        });
      } finally {
        // Restaurar botón
        submitBtn.disabled = false;
        submitBtn.textContent = 'Enviar Enlace';
        submitBtn.classList.remove('opacity-50');
      }
    });

    // Permitir enviar con Enter
    document.getElementById('email').addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        document.getElementById('submitBtn').click();
      }
    });
  </script>
</body>
</html>