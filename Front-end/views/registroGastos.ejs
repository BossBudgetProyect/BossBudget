<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="img/Logo.ico" type="image/x-icon">
  <title>Registro de Gastos</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }
    .title-font {
      font-family: 'Bebas Neue', sans-serif;
    }
    .video-background {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: -1;
      opacity: 0.15;
    }
    .form-container {
      backdrop-filter: blur(10px);
      background-color: rgba(255, 255, 255, 0.85);
    }
    .transition-all {
      transition: all 0.3s ease;
    }
    .modern-input {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      transition: all 0.3s ease;
      border: 8px solid rgba(234, 179, 8, 0.5);
    }
  </style>
</head>
<body class="relative min-h-screen flex items-center justify-center">
  <img src="/img/fondoiniciosesion.png" class="absolute inset-0 w-full h-full object-cover -z-10 glass-effect" alt="Fondo inicio sesión"> 

  <div class="form-container modern-input border rounded-xl shadow-2xl w-full max-w-md overflow-hidden transition-all">
    <div class="bg-purple-700 py-4 px-6">
      <h1 class="text-2xl title-font text-white text-center">Registrar Nuevo Gasto</h1>
    </div>

    <form id="gastoForm" class="p-6 space-y-4">
      <input type="hidden" id="idPresupuesto" value="<%= idPresupuesto %>">
      
      <!-- Categoría de gasto -->
      <div>
        <label for="tipoSelect" class="block text-sm font-medium text-gray-700 mb-1">Tipo de Gasto</label>
        <select id="tipoSelect" name="tipo" class="w-full p-3 modern-input border rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500" required>
          <option value="">Selecciona un tipo</option>
          <option value="Efectivo">Efectivo</option>
          <option value="Tarjeta Debito">Tarjeta Débito</option>
          <option value="Tarjeta credito">Tarjeta Crédito</option>
          <option value="Cheque">Cheque</option>
          <option value="Billeteras virtuales">Billeteras Virtuales</option>
          <option value="Otro">Otro</option>
        </select>
        <input id="otroTipoInput" name="otroTipo" type="text" placeholder="Especificar tipo de gasto..." 
               class="w-full mt-2 p-3 modern-input border rounded-lg hidden focus:ring-2 focus:ring-purple-500 focus:border-purple-500">
      </div>

      <!-- Monto -->
      <div>
        <label for="valor" class="block text-sm font-medium text-gray-700 mb-1">Monto</label>
        <div class="relative">
          <span class="absolute left-3 top-3 text-gray-500">$</span>
          <input type="number" id="valor" name="valor" 
                 class="w-full pl-8 p-3 modern-input border rounded-lg focus:border-purple-500" 
                 placeholder="0.00" min="0.01" step="0.01" required>
        </div>
      </div>

      <!-- Descripción -->
      <div>
        <label for="descripcion" class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
        <textarea id="descripcion" name="descripcion" rows="2"
                  class="w-full p-3 modern-input border rounded-lg focus:ring-2 focus:ring-purple-500"
                  placeholder="Ej: Supermercado, gasolina..." required></textarea>
      </div>

      <!-- Fecha -->
      <div>
        <label for="fecha" class="block text-sm font-medium text-gray-700 mb-1">Fecha</label>
        <input type="date" id="fecha" name="fecha" 
               class="w-full p-3 modern-input border rounded-lg focus:ring-2 focus:ring-purple-500"
               value="<%= new Date().toISOString().split('T')[0] %>" required>
      </div>

      <!-- Botones -->
      <div class="flex space-x-4 pt-4">
        <a href="/presupuesto/<%= idPresupuesto %>" 
           class="flex-1 bg-red-600 hover:bg-red-400 text-white text-center py-3 rounded-lg transition-all">
          Cancelar
        </a>
        <button type="submit" 
                class="flex-1 bg-yellow-600 hover:bg-yellow-700 text-white py-3 rounded-lg transition-all flex items-center justify-center">
          <span id="submitText">Registrar Gasto</span>
          <div id="loadingSpinner" class="hidden ml-2">
            <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></div>
          </div>
        </button>
      </div>
    </form>
  </div>

  <script>
    // Configuración
    const API_BASE = 'https://cautious-space-telegram-69wggvpp7p79f595w-3000.app.github.dev/api/gastos';
    const idPresupuesto = document.getElementById('idPresupuesto').value;

    // Mostrar campo "Otro" cuando se seleccione esa opción
    document.getElementById('tipoSelect').addEventListener('change', function() {
      const otroInput = document.getElementById('otroTipoInput');
      const isOtroSelected = this.value === 'Otro';
      
      otroInput.classList.toggle('hidden', !isOtroSelected);
      if (!isOtroSelected) otroInput.value = '';
      otroInput.toggleAttribute('required', isOtroSelected);
    });

    // Manejar envío del formulario con fetch
    document.getElementById('gastoForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      // Validaciones básicas
      if (!validarFormulario()) {
        return;
      }

      // Mostrar loading
      const submitBtn = document.querySelector('button[type="submit"]');
      const submitText = document.getElementById('submitText');
      const loadingSpinner = document.getElementById('loadingSpinner');
      
      submitText.textContent = 'Registrando...';
      loadingSpinner.classList.remove('hidden');
      submitBtn.disabled = true;

      try {
        // Preparar datos
        const formData = {
          tipo: document.getElementById('tipoSelect').value,
          otroTipo: document.getElementById('tipoSelect').value === 'Otro' ? 
                    document.getElementById('otroTipoInput').value.trim() : '',
          valor: parseFloat(document.getElementById('valor').value),
          descripcion: document.getElementById('descripcion').value.trim(),
          fecha: document.getElementById('fecha').value
        };

        console.log('Enviando datos:', formData);

        // Enviar con fetch
        const response = await fetch(`${API_BASE}/presupuesto/${idPresupuesto}`, {
          method: 'POST',
          credentials: 'include',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(formData)
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.error || 'Error al registrar gasto');
        }

        if (result.success) {
          // Mostrar éxito
          await Swal.fire({
            icon: 'success',
            title: '¡Éxito!',
            text: result.message || 'Gasto registrado correctamente',
            timer: 2000,
            showConfirmButton: false
          });

          // Redirigir al presupuesto
          window.location.href = `/presupuesto/${idPresupuesto}`;
        } else {
          throw new Error(result.error);
        }

      } catch (error) {
        console.error('Error:', error);
        
        // Mostrar error
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: error.message || 'No se pudo registrar el gasto',
          confirmButtonText: 'Entendido'
        });

        // Restaurar botón
        submitText.textContent = 'Registrar Gasto';
        loadingSpinner.classList.add('hidden');
        submitBtn.disabled = false;
      }
    });

    // Función de validación
    function validarFormulario() {
      const tipoSelect = document.getElementById('tipoSelect');
      const valorInput = document.getElementById('valor');
      const descripcionInput = document.getElementById('descripcion');
      const fechaInput = document.getElementById('fecha');
      const otroTipoInput = document.getElementById('otroTipoInput');

      // Validar tipo seleccionado
      if (!tipoSelect.value) {
        Swal.fire('Error', 'Por favor selecciona un tipo de gasto', 'error');
        tipoSelect.focus();
        return false;
      }

      // Validar campo "Otro" si está visible
      if (tipoSelect.value === 'Otro' && !otroTipoInput.value.trim()) {
        Swal.fire('Error', 'Por favor especifica el tipo de gasto', 'error');
        otroTipoInput.focus();
        return false;
      }

      // Validar monto
      if (!valorInput.value || parseFloat(valorInput.value) <= 0) {
        Swal.fire('Error', 'El monto debe ser mayor a cero', 'error');
        valorInput.focus();
        return false;
      }

      // Validar descripción
      if (!descripcionInput.value.trim()) {
        Swal.fire('Error', 'Por favor ingresa una descripción', 'error');
        descripcionInput.focus();
        return false;
      }

      // Validar fecha
      if (!fechaInput.value) {
        Swal.fire('Error', 'Por favor selecciona una fecha', 'error');
        fechaInput.focus();
        return false;
      }

      return true;
    }

    // Validación en tiempo real
    document.getElementById('valor').addEventListener('input', function() {
      if (this.value < 0) {
        this.value = '';
      }
    });
  </script>
</body>
</html>