<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Configuración de Cuenta</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
    .animate-pulse {
      animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    
    .skeleton {
      background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
      background-size: 200% 100%;
      animation: loading 1.5s infinite;
    }
    
    @keyframes loading {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }

    /* Fondo que cubre toda la página */
    .full-page-bg {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -10;
      object-fit: cover;
    }

    /* Mejoras visuales suavizadas */
    .glass-effect {
      backdrop-filter: blur(12px) saturate(160%);
      background-color: rgba(255, 255, 255, 0.85);
    }

    .gradient-border {
      background: linear-gradient(45deg, #7c3aed, #a855f7, #f59e0b);
      padding: 1px;
      border-radius: 12px;
    }

    .stats-card {
      transition: all 0.3s ease;
      cursor: pointer;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .stats-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
    }

    .avatar-upload {
      transition: all 0.3s ease;
    }

    .avatar-upload:hover {
      transform: scale(1.05);
    }

    /* Colores suavizados */
    .bg-morado-suave {
      background-color: #8b5cf6;
    }

    .bg-amarillo-suave {
      background-color: #f59e0b;
    }

    .text-morado-oscuro {
      color: #5b21b6;
    }

    .text-amarillo-oscuro {
      color: #92400e;
    }
  </style>
</head>
<body class="min-h-screen bg-gray-50">
  <!-- Fondo mejorado -->
  <img src="img/FondoRegistro.png" class="full-page-bg">
  
  <!-- Navbar -->

  <!-- Loading Overlay mejorado -->
  <div id="loadingOverlay" class="fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center z-50">
    <div class="glass-effect rounded-2xl p-8 flex flex-col items-center shadow-lg border border-purple-100">
      <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-purple-500 mb-4"></div>
      <p class="text-gray-800 text-lg font-semibold">Cargando tu información...</p>
      <p class="text-gray-600 text-sm mt-2">Estamos preparando todo para ti</p>
    </div>
  </div>

  <!-- Contenido principal mejorado -->
  <div class="max-w-6xl mx-auto my-8 px-4 pt-16">
    <div class="gradient-border">
      <div class="glass-effect rounded-xl shadow-lg border border-purple-100">
        <div class="min-h-screen py-8">
          <!-- Formulario principal -->
          <form id="userForm" class="max-w-5xl mx-auto px-6 space-y-8" style="display: none;">
            <!-- Header mejorado -->
            <div class="text-center space-y-4 pt-4">
              <div class="inline-flex items-center justify-center space-x-4">
                <div class="w-12 h-12 bg-gradient-to-r from-purple-500 to-purple-600 rounded-full flex items-center justify-center shadow-md">
                  <span class="text-white text-xl">👤</span>
                </div>
                <h1 class="text-4xl font-bold bg-gradient-to-r from-purple-600 to-amber-500 bg-clip-text text-transparent">
                  Mi Cuenta
                </h1>
              </div>
              <p class="text-gray-700 text-lg max-w-2xl mx-auto">Gestiona tu perfil, seguridad y preferencias financieras</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
              <!-- Profile Card mejorada -->
              <div class="lg:col-span-1 space-y-6">
                <!-- Tarjeta de Perfil -->
                <div class="bg-gradient-to-br from-purple-500 to-purple-600 rounded-2xl shadow-lg overflow-hidden">
                  <div class="p-6 text-center text-white">
                    <div class="flex items-center justify-center gap-3 font-bold text-lg">
                      <span>👤</span> Perfil Personal
                    </div>
                  </div>
                  <div class="px-6 pb-6 space-y-6">
                    <!-- Profile Picture mejorada -->
                    <div class="flex flex-col items-center space-y-4">
                      <div class="relative avatar-upload">
                        <div id="avatarContainer" class="h-28 w-28 rounded-full border-4 border-white/40 shadow-lg flex items-center justify-center bg-white/20 backdrop-blur-sm overflow-hidden">
                          <!-- Avatar se cargará dinámicamente -->
                        </div>
                        <label for="avatarInput" class="absolute -bottom-2 -right-2 h-10 w-10 rounded-full p-0 bg-white hover:bg-gray-100 shadow-md flex items-center justify-center cursor-pointer transition-all duration-300">
                          <span class="text-purple-600 text-sm">📷</span>
                          <input type="file" id="avatarInput" name="avatar" accept="image/*" class="hidden">
                        </label>
                      </div>
                      <button type="button" onclick="document.getElementById('avatarInput').click()" class="w-full py-3 px-4 rounded-xl border border-white/30 bg-white/10 text-white hover:bg-white/20 backdrop-blur-sm text-sm font-medium transition-all duration-300">
                        ✨ Cambiar Foto
                      </button>
                    </div>
                  </div>
                </div>

                <!-- Estadísticas en Tiempo Real -->
                <div id="statsContainer" class="space-y-4">
                  <!-- Los presupuestos activos se cargarán aquí dinámicamente -->
                </div>
              </div>

              <!-- Main Settings mejorado -->
              <div class="lg:col-span-2 space-y-6">
                <!-- Información Personal mejorada -->
                <div class="border-none">
                  <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-purple-100">
                    <button type="button" class="accordion-trigger w-full px-6 py-5 text-left flex justify-between items-center hover:bg-purple-50 transition-colors duration-200 border-b border-purple-50">
                      <div class="flex items-center gap-3 text-purple-800 font-bold text-lg">
                        <span class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center text-purple-600">📋</span>
                        Información Personal
                        <span class="icon-chevron-down accordion-icon text-purple-500 transform transition-transform duration-300">▼</span>
                      </div>
                    </button>
                    <div class="accordion-content px-6 pb-6 space-y-5">
                      <p class="text-gray-600 mb-4 text-sm">Actualiza tu información básica para personalizar tu experiencia</p>
                      
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="space-y-2">
                          <label for="nombres" class="text-gray-700 font-semibold text-sm flex items-center gap-2">
                            <span class="text-purple-500">👤</span> Nombre
                          </label>
                          <input
                            id="nombres"
                            name="nombres"
                            placeholder="Ej: Juan Carlos"
                            class="w-full px-4 py-3 border border-gray-300 bg-white text-gray-800 placeholder:text-gray-400 focus:border-purple-500 focus:ring-2 focus:ring-purple-100 rounded-xl transition-all duration-200"
                          />
                        </div>
                        <div class="space-y-2">
                          <label for="apellidos" class="text-gray-700 font-semibold text-sm flex items-center gap-2">
                            <span class="text-purple-500">👥</span> Apellido
                          </label>
                          <input
                            id="apellidos"
                            name="apellidos"
                            placeholder="Ej: Pérez García"
                            class="w-full px-4 py-3 border border-gray-300 bg-white text-gray-800 placeholder:text-gray-400 focus:border-purple-500 focus:ring-2 focus:ring-purple-100 rounded-xl transition-all duration-200"
                          />
                        </div>
                      </div>

                      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="space-y-2">
                          <label for="nombreUsuario" class="text-gray-700 font-semibold text-sm flex items-center gap-2">
                            <span class="text-purple-500">🎯</span> Nombre de Usuario
                          </label>
                          <div class="relative">
                            <input
                              id="nombreUsuario"
                              name="nombreUsuario"
                              placeholder="juanito123"
                              disabled
                              class="w-full px-4 py-3 border border-gray-300 bg-gray-50 text-gray-600 placeholder:text-gray-400 rounded-xl cursor-not-allowed"
                            />
                            <button type="button" onclick="habilitarEdicionUsuario()" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-purple-500 hover:text-purple-700 transition-colors" title="Editar nombre de usuario">
                              ✏️
                            </button>
                          </div>
                        </div>
                        <div class="space-y-2">
                          <label for="correo" class="text-gray-700 font-semibold text-sm flex items-center gap-2">
                            <span class="text-purple-500">📧</span> Correo Electrónico
                          </label>
                          <input
                            id="correo"
                            name="correo"
                            type="email"
                            placeholder="juan@ejemplo.com"
                            disabled
                            class="w-full px-4 py-3 border border-gray-300 bg-gray-50 text-gray-600 placeholder:text-gray-400 rounded-xl cursor-not-allowed"
                          />
                        </div>
                      </div>

                      <div class="space-y-2">
                        <label for="profesion" class="text-gray-700 font-semibold text-sm flex items-center gap-2">
                          <span class="text-purple-500">💼</span> Profesión
                        </label>
                        <input
                          id="profesion"
                          name="profesion"
                          placeholder="Ej: Ingeniero de Software, Diseñador UX, Estudiante..."
                          class="w-full px-4 py-3 border border-gray-300 bg-white text-gray-800 placeholder:text-gray-400 focus:border-purple-500 focus:ring-2 focus:ring-purple-100 rounded-xl transition-all duration-200"
                        />
                      </div>

                      <div class="space-y-2">
                        <label for="expectativas" class="text-gray-700 font-semibold text-sm flex items-center gap-2">
                          <span class="text-purple-500">🎯</span> Mis Objetivos Financieros
                        </label>
                        <textarea
                          id="expectativas"
                          name="expectativas"
                          placeholder="Cuéntanos sobre tus metas financieras, qué esperas lograr con esta aplicación, o cualquier objetivo que tengas..."
                          rows="4"
                          class="w-full px-4 py-3 border border-gray-300 bg-white text-gray-800 placeholder:text-gray-400 focus:border-purple-500 focus:ring-2 focus:ring-purple-100 rounded-xl transition-all duration-200 resize-none"
                        ></textarea>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Seguridad mejorada -->
                <div class="border-none">
                  <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-purple-100">
                    <button type="button" class="accordion-trigger w-full px-6 py-5 text-left flex justify-between items-center hover:bg-purple-50 transition-colors duration-200 border-b border-purple-50">
                      <div class="flex items-center gap-3 text-purple-800 font-bold text-lg">
                        <span class="w-8 h-8 bg-purple-100 rounded-full flex items-center justify-center text-purple-600">🛡️</span>
                        Seguridad y Contraseña
                        <span class="icon-chevron-down accordion-icon text-purple-500 transform transition-transform duration-300">▼</span>
                      </div>
                    </button>
                    <div class="accordion-content hidden px-6 pb-6 space-y-5">
                      <p class="text-gray-600 mb-4 text-sm">Protege tu cuenta actualizando regularmente tu contraseña</p>
                      
                      <div class="space-y-4">
                        <div class="space-y-2">
                          <label for="currentPassword" class="text-gray-700 font-semibold text-sm flex items-center gap-2">
                            <span class="text-purple-500">🔐</span> Contraseña Actual
                          </label>
                          <input
                            id="currentPassword"
                            name="contrasenaActual"
                            type="password"
                            placeholder="Ingresa tu contraseña actual"
                            class="w-full px-4 py-3 border border-gray-300 bg-white text-gray-800 placeholder:text-gray-400 focus:border-purple-500 focus:ring-2 focus:ring-purple-100 rounded-xl transition-all duration-200"
                          />
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                          <div class="space-y-2">
                            <label for="newPassword" class="text-gray-700 font-semibold text-sm flex items-center gap-2">
                              <span class="text-purple-500">🔄</span> Nueva Contraseña
                            </label>
                            <input
                              id="newPassword"
                              name="nuevaContrasena"
                              type="password"
                              placeholder="Mínimo 8 caracteres"
                              class="w-full px-4 py-3 border border-gray-300 bg-white text-gray-800 placeholder:text-gray-400 focus:border-purple-500 focus:ring-2 focus:ring-purple-100 rounded-xl transition-all duration-200"
                            />
                          </div>
                          <div class="space-y-2">
                            <label for="confirmPassword" class="text-gray-700 font-semibold text-sm flex items-center gap-2">
                              <span class="text-purple-500">✅</span> Confirmar Contraseña
                            </label>
                            <input
                              id="confirmPassword"
                              name="confirmarContrasena"
                              type="password"
                              placeholder="Repite la nueva contraseña"
                              class="w-full px-4 py-3 border border-gray-300 bg-white text-gray-800 placeholder:text-gray-400 focus:border-purple-500 focus:ring-2 focus:ring-purple-100 rounded-xl transition-all duration-200"
                            />
                          </div>
                        </div>

                        <div class="bg-purple-50 border border-purple-200 rounded-xl p-4">
                          <div class="flex items-start gap-3">
                            <span class="text-purple-500 text-lg">💡</span>
                            <div>
                              <p class="text-purple-800 font-semibold text-sm">Recomendaciones de seguridad:</p>
                              <ul class="text-purple-600 text-xs mt-1 space-y-1">
                                <li>• Usa una combinación de letras, números y símbolos</li>
                                <li>• Evita contraseñas que uses en otros servicios</li>
                                <li>• Cambia tu contraseña regularmente</li>
                              </ul>
                            </div>
                          </div>
                        </div>

                        <button type="button" id="changePasswordBtn" class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-purple-500 to-purple-600 hover:from-purple-600 hover:to-purple-700 text-white font-semibold shadow-md transition-all duration-300 transform hover:scale-105">
                          🛡️ Actualizar Contraseña
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Action Buttons mejorados -->
            <div class="flex flex-col sm:flex-row gap-4 justify-end pb-8 pt-6">
              <a href="/principal" class="sm:w-auto w-full py-3 px-8 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-600 hover:to-amber-700 text-white font-semibold shadow-md transition-all duration-300 transform hover:scale-105 flex items-center justify-center gap-2 text-center">
                <span>🏠</span> Volver al Principal
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Configuración de APIs
    const API_BASE = 'https://bossbudgetapi-production.up.railway.app/api/auth';
    const API_PRESUPUESTOS = 'https://bossbudgetapi-production.up.railway.app/api/presupuestos';

    // Función para cargar datos del usuario
    async function cargarDatosUsuario() {
        try {
            console.log('🔄 Cargando datos del usuario...');
            
            const [userResponse, budgetsResponse] = await Promise.all([
                fetch(`${API_BASE}/perfil`, {
                    method: 'GET',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' }
                }),
                fetch(`${API_PRESUPUESTOS}/activos`, {
                    method: 'GET',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json' }
                })
            ]);

            if (!userResponse.ok) {
                throw new Error(`Error ${userResponse.status}: ${userResponse.statusText}`);
            }

            const userResult = await userResponse.json();
            let budgetsData = [];

            if (budgetsResponse.ok) {
                const budgetsResult = await budgetsResponse.json();
                if (budgetsResult.success) {
                    budgetsData = budgetsResult.data;
                }
            }

            if (userResult.success) {
                const userData = userResult.data;
                console.log('✅ Datos del usuario cargados:', userData);
                console.log('📊 Presupuestos activos:', budgetsData);
                
                actualizarVistaConDatos(userData, budgetsData);
                
                document.getElementById('loadingOverlay').style.display = 'none';
                document.getElementById('userForm').style.display = 'block';
                
            } else {
                throw new Error(userResult.error || 'Error en la respuesta del servidor');
            }

        } catch (error) {
            console.error('❌ Error cargando datos:', error);
            mostrarError('Error al cargar los datos: ' + error.message);
            document.getElementById('loadingOverlay').style.display = 'none';
            document.getElementById('userForm').style.display = 'block';
        }
    }

    // Función para actualizar la vista con datos
    function actualizarVistaConDatos(userData, budgetsData) {
        // Información personal
        document.getElementById('nombres').value = userData.Nombres || '';
        document.getElementById('apellidos').value = userData.Apellidos || '';
        document.getElementById('nombreUsuario').value = userData.NombreUsuario || '';
        document.getElementById('correo').value = userData.Correo || '';
        document.getElementById('profesion').value = userData.Profesion || '';
        document.getElementById('expectativas').value = userData.Expectativas || '';

        // Avatar
        const avatarContainer = document.getElementById('avatarContainer');
        if (userData.Foto) {
            avatarContainer.innerHTML = `<img src="/uploads/${userData.Foto}" alt="Avatar" class="w-full h-full object-cover">`;
        } else {
            const initials = (userData.Nombres?.charAt(0) || '') + (userData.Apellidos?.charAt(0) || '');
            avatarContainer.innerHTML = `<span class="text-white text-xl font-bold">${initials || 'U'}</span>`;
        }

        // Estadísticas de presupuestos
        actualizarEstadisticasPresupuestos(budgetsData);
    }

    // Función para actualizar estadísticas de presupuestos
    function actualizarEstadisticasPresupuestos(budgetsData) {
        const statsContainer = document.getElementById('statsContainer');
        
        if (!budgetsData || budgetsData.length === 0) {
            statsContainer.innerHTML = `
                <div class="bg-gradient-to-br from-gray-500 to-gray-600 rounded-2xl shadow-lg overflow-hidden stats-card">
                    <div class="p-5 text-center text-white">
                        <div class="flex items-center justify-center gap-2 font-bold text-lg mb-2">
                            <span>📊</span> Mis Presupuestos
                        </div>
                        <p class="text-gray-200 text-sm">No tienes presupuestos activos</p>
                        <a href="/crearPresupuesto" class="inline-block mt-3 px-4 py-2 bg-white/20 hover:bg-white/30 text-white rounded-lg text-sm transition-colors">
                            Crear Presupuesto
                        </a>
                    </div>
                </div>
            `;
            return;
        }

        const totalPresupuesto = budgetsData.reduce((sum, budget) => sum + parseFloat(budget.monto || 0), 0);
        const totalGastos = budgetsData.reduce((sum, budget) => sum + parseFloat(budget.gastos_totales || 0), 0);
        const disponible = totalPresupuesto - totalGastos;

        statsContainer.innerHTML = `
            <div class="bg-gradient-to-br from-purple-500 to-purple-600 rounded-2xl shadow-lg overflow-hidden stats-card">
                <div class="p-5 text-center text-white">
                    <div class="flex items-center justify-center gap-2 font-bold text-lg mb-2">
                        <span>💰</span> Presupuestos Activos
                    </div>
                    <p class="text-2xl font-bold">${budgetsData.length}</p>
                    <p class="text-purple-100 text-sm">presupuesto(s) en curso</p>
                </div>
            </div>

            <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl shadow-lg overflow-hidden stats-card">
                <div class="p-5 text-center text-white">
                    <div class="flex items-center justify-center gap-2 font-bold text-lg mb-2">
                        <span>📈</span> Total Presupuestado
                    </div>
                    <p class="text-2xl font-bold">$${totalPresupuesto.toFixed(2)}</p>
                    <p class="text-blue-100 text-sm">límite total</p>
                </div>
            </div>

            <div class="bg-gradient-to-br from-amber-500 to-amber-600 rounded-2xl shadow-lg overflow-hidden stats-card">
                <div class="p-5 text-center text-white">
                    <div class="flex items-center justify-center gap-2 font-bold text-lg mb-2">
                        <span>💸</span> Gastado Total
                    </div>
                    <p class="text-2xl font-bold">$${totalGastos.toFixed(2)}</p>
                    <p class="text-amber-100 text-sm">de tus presupuestos</p>
                </div>
            </div>

            <div class="bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-2xl shadow-lg overflow-hidden stats-card">
                <div class="p-5 text-center text-white">
                    <div class="flex items-center justify-center gap-2 font-bold text-lg mb-2">
                        <span>🎯</span> Disponible
                    </div>
                    <p class="text-2xl font-bold">$${disponible.toFixed(2)}</p>
                    <p class="text-emerald-100 text-sm">para gastar</p>
                </div>
            </div>
        `;
    }

    // Función para actualizar perfil (guardado automático)
    async function actualizarCampo(campo, valor) {
        try {
            const datos = { [campo]: valor };
            const response = await fetch(`${API_BASE}/perfil`, {
                method: 'PUT',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(datos)
            });

            if (!response.ok) {
                const errorData = await response.json();
                throw new Error(errorData.error || `Error ${response.status}: ${response.statusText}`);
            }

            const result = await response.json();
            
            if (result.success) {
                mostrarExitoSuave('Cambios guardados');
                return result.data;
            } else {
                throw new Error(result.error || 'Error en la respuesta del servidor');
            }

        } catch (error) {
            console.error('Error actualizando perfil:', error);
            mostrarError('Error al guardar: ' + error.message);
            throw error;
        }
    }

    // Función para cambiar contraseña
    async function cambiarContraseña(contraseñaActual, nuevaContraseña) {
        try {
            const response = await fetch(`${API_BASE}/cambiar-password`, {
                method: 'PUT',
                credentials: 'include',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ contraseñaActual, nuevaContraseña })
            });

            if (!response.ok) {
                const errorData = await response.json();
                throw new Error(errorData.error || 'Error al cambiar contraseña');
            }

            const result = await response.json();
            return result;

        } catch (error) {
            console.error('Error cambiando contraseña:', error);
            throw error;
        }
    }

    // Funciones de UI mejoradas
    function mostrarExitoSuave(mensaje) {
        // Toast suave en lugar de alerta grande
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 2000,
            timerProgressBar: true,
            background: '#f0f9ff',
            color: '#0369a1'
        });
        
        Toast.fire({
            icon: 'success',
            title: mensaje
        });
    }

    function mostrarError(mensaje) {
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: mensaje,
            background: '#fef2f2',
            color: '#dc2626'
        });
    }

    function habilitarEdicionUsuario() {
        Swal.fire({
            title: 'Editar Nombre de Usuario',
            text: 'Esta función estará disponible próximamente. Por ahora, contacta con soporte si necesitas cambiar tu nombre de usuario.',
            icon: 'info',
            confirmButtonText: 'Entendido',
            background: '#f0f9ff',
            color: '#0369a1'
        });
    }

    // Event Listeners para guardado automático
    function configurarGuardadoAutomatico() {
        const campos = ['nombres', 'apellidos', 'profesion', 'expectativas'];
        
        campos.forEach(campo => {
            const elemento = document.getElementById(campo);
            if (elemento) {
                // Guardar cuando el usuario sale del campo
                elemento.addEventListener('blur', async function() {
                    if (this.value.trim() !== this.defaultValue) {
                        try {
                            await actualizarCampo(campo, this.value.trim());
                            this.defaultValue = this.value.trim();
                        } catch (error) {
                            // El error ya se muestra en la función actualizarCampo
                        }
                    }
                });

                // Guardar con Enter
                elemento.addEventListener('keypress', async function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        this.blur();
                    }
                });
            }
        });
    }

    document.getElementById('changePasswordBtn').addEventListener('click', async function() {
        const currentPassword = document.getElementById('currentPassword').value;
        const newPassword = document.getElementById('newPassword').value;
        const confirmPassword = document.getElementById('confirmPassword').value;

        if (!currentPassword || !newPassword || !confirmPassword) {
            mostrarError('Todos los campos de contraseña son requeridos');
            return;
        }

        if (newPassword.length < 8) {
            mostrarError('La nueva contraseña debe tener al menos 8 caracteres');
            return;
        }

        if (newPassword !== confirmPassword) {
            mostrarError('Las contraseñas no coinciden');
            return;
        }

        try {
            await cambiarContraseña(currentPassword, newPassword);
            mostrarExitoSuave('Contraseña cambiada exitosamente');
            
            // Limpiar campos
            document.getElementById('currentPassword').value = '';
            document.getElementById('newPassword').value = '';
            document.getElementById('confirmPassword').value = '';

        } catch (error) {
            mostrarError('Error: ' + error.message);
        }
    });

    // Accordion functionality
    document.querySelectorAll('.accordion-trigger').forEach(trigger => {
        trigger.addEventListener('click', () => {
            const content = trigger.nextElementSibling;
            const icon = trigger.querySelector('.accordion-icon');
            
            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                icon.classList.add('rotate-180');
            } else {
                content.classList.add('hidden');
                icon.classList.remove('rotate-180');
            }
        });
    });

    // Inicialización
    document.addEventListener('DOMContentLoaded', function() {
        console.log('🚀 Iniciando carga de datos del usuario...');
        cargarDatosUsuario();
        configurarGuardadoAutomatico();
    });
  </script>
</body>
</html>